{
  "name": "flowforge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests scripts playwright.config.ts --max-warnings 0",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:browser": "node scripts/browser-tests.mjs",
    "validate:browser": "npm run validate && npm run test:browser",
    "verify:config": "node scripts/verify-config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@upstash/qstash": "2.12.0",
    "@xyflow/react": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "^16.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
